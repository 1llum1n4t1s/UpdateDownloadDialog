<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:VelopackUpdateDialog"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="200"
             x:Class="VelopackUpdateDialog.UpdateDialogView"
             x:DataType="vm:UpdateDialogViewModel">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://VelopackUpdateDialog/Themes/Themes.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <StyleInclude Source="avares://VelopackUpdateDialog/Themes/Styles.axaml"/>
  </UserControl.Styles>

  <Grid Margin="16,8">

    <!-- 確認中 -->
    <StackPanel Orientation="Vertical"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding IsChecking}">
      <ProgressBar IsIndeterminate="True" Width="240" Height="6"/>
      <TextBlock Margin="0,12,0,0"
                 HorizontalAlignment="Center"
                 Text="{Binding Strings.CheckingMessage}"/>
    </StackPanel>

    <!-- 新バージョン利用可能 -->
    <StackPanel Orientation="Vertical" IsVisible="{Binding IsAvailable}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8">
        <Path Width="14" Height="14"
              Margin="0,0,8,0"
              Stretch="Uniform"
              VerticalAlignment="Center"
              Data="{StaticResource UpdateDialog.InfoGeometry}"
              Fill="{DynamicResource UpdateDialog.SuccessBrush}"/>
        <TextBlock FontWeight="Bold" FontSize="14"
                   VerticalAlignment="Center"
                   Text="{Binding Strings.AvailableHeader}"/>
        <Border Margin="4,0,0,0" Height="20" CornerRadius="10"
                VerticalAlignment="Center"
                Background="{Binding AccentBrush, FallbackValue={DynamicResource UpdateDialog.AccentBrush}, TargetNullValue={DynamicResource UpdateDialog.AccentBrush}}"
                Effect="drop-shadow(0 0 6 #40000000)">
          <TextBlock Margin="8,0" Text="{Binding AvailableTagName}" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
        </Border>
      </StackPanel>

      <StackPanel Margin="0,8,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
        <Button x:Name="BtnDownload"
                Classes="primary"
                Height="30"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Click="OnDownloadAndInstall">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Path Width="12" Height="12" Margin="0,0,8,0" Stretch="Uniform" VerticalAlignment="Center"
                  Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"
                  Fill="White"/>
            <TextBlock Text="{Binding Strings.DownloadAndInstall}"
                       VerticalAlignment="Center" Foreground="White"/>
          </StackPanel>
        </Button>

        <Button x:Name="BtnIgnore"
                Classes="secondary"
                Height="30"
                Margin="8,0,0,0"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                IsVisible="{Binding AllowIgnoreVersion}"
                Click="OnIgnoreVersion">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Path Width="12" Height="12" Margin="0,0,8,0" Stretch="Uniform" VerticalAlignment="Center"
                  Data="M12 2C6.47 2 2 6.47 2 12s4.47 10 10 10 10-4.47 10-10S17.53 2 12 2zm5 13.59L15.59 17 12 13.41 8.41 17 7 15.59 10.59 12 7 8.41 8.41 7 12 10.59 15.59 7 17 8.41 13.41 12 17 15.59z"
                  Fill="{DynamicResource UpdateDialog.ForegroundBrush}"/>
            <TextBlock Text="{Binding Strings.IgnoreThisVersion}"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </StackPanel>

    <!-- ダウンロード中 -->
    <StackPanel Orientation="Vertical" IsVisible="{Binding IsDownloading}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8">
        <Path Width="14" Height="14"
              Margin="0,0,8,0"
              Stretch="Uniform"
              VerticalAlignment="Center"
              Data="{StaticResource UpdateDialog.InfoGeometry}"
              Fill="{DynamicResource UpdateDialog.SuccessBrush}"/>
        <TextBlock FontWeight="Bold" FontSize="14"
                   VerticalAlignment="Center"
                   Text="{Binding Strings.AvailableHeader}"/>
        <Border Margin="4,0,0,0" Height="20" CornerRadius="10"
                VerticalAlignment="Center"
                Background="{Binding AccentBrush, FallbackValue={DynamicResource UpdateDialog.AccentBrush}, TargetNullValue={DynamicResource UpdateDialog.AccentBrush}}"
                Effect="drop-shadow(0 0 6 #40000000)">
          <TextBlock Margin="8,0" Text="{Binding AvailableTagName}" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
        </Border>
      </StackPanel>

      <ProgressBar Minimum="0" Maximum="100"
                   Value="{Binding DownloadProgress}"
                   Height="8" Margin="0,8,0,0" Width="500"/>
    </StackPanel>

    <!-- 最新版 -->
    <StackPanel Orientation="Vertical" IsVisible="{Binding IsUpToDate}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8">
        <Path Width="14" Height="14"
              Margin="0,0,8,0"
              Stretch="Uniform"
              VerticalAlignment="Center"
              Data="{StaticResource UpdateDialog.InfoGeometry}"
              Fill="{DynamicResource UpdateDialog.SuccessBrush}"/>
        <TextBlock VerticalAlignment="Center"
                   Text="{Binding Strings.UpToDateMessage}"/>
      </StackPanel>

      <Button Classes="primary"
              Height="30"
              Margin="4,0"
              Click="OnClose"
              Content="{Binding Strings.Close}"
              HorizontalAlignment="Center"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"/>
    </StackPanel>

    <!-- 失敗 -->
    <StackPanel Orientation="Vertical" IsVisible="{Binding IsFailed}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Path Width="14" Height="14"
              Margin="0,0,8,0"
              Stretch="Uniform"
              VerticalAlignment="Center"
              Data="M12 2C6.47 2 2 6.47 2 12s4.47 10 10 10 10-4.47 10-10S17.53 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
              Fill="{DynamicResource UpdateDialog.ErrorBrush}"/>
        <TextBlock FontWeight="Bold" FontSize="14"
                   VerticalAlignment="Center"
                   Text="{Binding Strings.ErrorHeader}"/>
      </StackPanel>

      <TextBlock Text="{Binding ErrorMessage}" MaxWidth="500" TextWrapping="Wrap" Margin="0,8"/>

      <Button Classes="primary"
              Height="30"
              Margin="4,0"
              Click="OnClose"
              Content="{Binding Strings.Close}"
              HorizontalAlignment="Center"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"/>
    </StackPanel>

  </Grid>
</UserControl>
