<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:VelopackUpdateDialog"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="220"
        x:Class="VelopackUpdateDialog.UpdateDialogWindow"
        x:DataType="vm:UpdateDialogViewModel"
        x:Name="ThisWindow"
        Title="{Binding Strings.Title}"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource UpdateDialog.WindowBackground}">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://VelopackUpdateDialog/Themes/Themes.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Window.Styles>
    <StyleInclude Source="avares://VelopackUpdateDialog/Themes/Styles.axaml"/>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*">

    <!-- カスタム タイトルバー (ChromeMode == Custom 時) -->
    <Grid Grid.Row="0" Height="28" x:Name="CustomTitleBar">
      <Border Background="{DynamicResource UpdateDialog.TitleBarBrush}"
              BorderThickness="0,0,0,1"
              BorderBrush="{DynamicResource UpdateDialog.BorderBrush}"
              PointerPressed="OnTitleBarPointerPressed"/>

      <Path Width="14" Height="14"
            Margin="10,0,0,0"
            HorizontalAlignment="Left"
            Data="{Binding Icons.SoftwareUpdate}"
            Fill="{DynamicResource UpdateDialog.ForegroundBrush}"/>

      <TextBlock FontWeight="Bold"
                 Text="{Binding Strings.Title}"
                 Foreground="{DynamicResource UpdateDialog.ForegroundBrush}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 IsHitTestVisible="False"/>

      <Button x:Name="BtnClose"
              HorizontalAlignment="Right"
              VerticalAlignment="Stretch"
              Width="46"
              Padding="0"
              Background="Transparent"
              BorderThickness="0"
              Foreground="{DynamicResource UpdateDialog.ForegroundBrush}"
              Click="OnCloseClicked">
        <Path Width="10" Height="10"
              Stretch="Uniform"
              Stroke="{DynamicResource UpdateDialog.ForegroundBrush}"
              StrokeThickness="1.2"
              Data="M 0,0 L 10,10 M 10,0 L 0,10"/>
      </Button>
    </Grid>

    <!-- 本体 -->
    <vm:UpdateDialogView Grid.Row="1"
                       x:Name="DialogBody"
                       DataContext="{Binding}"/>

  </Grid>
</Window>
