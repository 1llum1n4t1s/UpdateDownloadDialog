<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>

    <!-- Light -->
    <ResourceDictionary x:Key="Light">
      <Color x:Key="UpdateDialog.WindowBackgroundColor">#FFFFFFFF</Color>
      <Color x:Key="UpdateDialog.TitleBarColor">#FFF5F5F5</Color>
      <Color x:Key="UpdateDialog.BorderColor">#FFDDDDDD</Color>
      <Color x:Key="UpdateDialog.ForegroundColor">#FF202020</Color>
      <Color x:Key="UpdateDialog.AccentColor">#FF0066FF</Color>
      <Color x:Key="UpdateDialog.SuccessColor">#FF1FA851</Color>
      <Color x:Key="UpdateDialog.ErrorColor">#FFDA3D3D</Color>
      <!-- secondary ボタン面: 白背景から浮く程度の薄いグレー。枠線だけでは同化するため塗りで差をつける -->
      <Color x:Key="UpdateDialog.ControlFillColor">#FFEDEDED</Color>
      <Color x:Key="UpdateDialog.ControlFillHoverColor">#FFDFDFDF</Color>

      <SolidColorBrush x:Key="UpdateDialog.WindowBackground" Color="{StaticResource UpdateDialog.WindowBackgroundColor}"/>
      <SolidColorBrush x:Key="UpdateDialog.TitleBarBrush" Color="{StaticResource UpdateDialog.TitleBarColor}"/>
      <SolidColorBrush x:Key="UpdateDialog.BorderBrush" Color="{StaticResource UpdateDialog.BorderColor}"/>
      <SolidColorBrush x:Key="UpdateDialog.ForegroundBrush" Color="{StaticResource UpdateDialog.ForegroundColor}"/>
      <SolidColorBrush x:Key="UpdateDialog.AccentBrush" Color="{StaticResource UpdateDialog.AccentColor}"/>
      <SolidColorBrush x:Key="UpdateDialog.SuccessBrush" Color="{StaticResource UpdateDialog.SuccessColor}"/>
      <SolidColorBrush x:Key="UpdateDialog.ErrorBrush" Color="{StaticResource UpdateDialog.ErrorColor}"/>
      <SolidColorBrush x:Key="UpdateDialog.ControlFillBrush" Color="{StaticResource UpdateDialog.ControlFillColor}"/>
      <SolidColorBrush x:Key="UpdateDialog.ControlFillHoverBrush" Color="{StaticResource UpdateDialog.ControlFillHoverColor}"/>
    </ResourceDictionary>

    <!-- Dark -->
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="UpdateDialog.WindowBackgroundColor">#FF1E1E1E</Color>
      <Color x:Key="UpdateDialog.TitleBarColor">#FF252526</Color>
      <Color x:Key="UpdateDialog.BorderColor">#FF3F3F3F</Color>
      <Color x:Key="UpdateDialog.ForegroundColor">#FFE0E0E0</Color>
      <Color x:Key="UpdateDialog.AccentColor">#FF4A9EFF</Color>
      <Color x:Key="UpdateDialog.SuccessColor">#FF4FCB7A</Color>
      <Color x:Key="UpdateDialog.ErrorColor">#FFFF6B6B</Color>
      <!-- secondary ボタン面: 暗い窓背景から少し明るく浮かせる -->
      <Color x:Key="UpdateDialog.ControlFillColor">#FF333334</Color>
      <Color x:Key="UpdateDialog.ControlFillHoverColor">#FF3F3F41</Color>

      <SolidColorBrush x:Key="UpdateDialog.WindowBackground" Color="{StaticResource UpdateDialog.WindowBackgroundColor}"/>
      <SolidColorBrush x:Key="UpdateDialog.TitleBarBrush" Color="{StaticResource UpdateDialog.TitleBarColor}"/>
      <SolidColorBrush x:Key="UpdateDialog.BorderBrush" Color="{StaticResource UpdateDialog.BorderColor}"/>
      <SolidColorBrush x:Key="UpdateDialog.ForegroundBrush" Color="{StaticResource UpdateDialog.ForegroundColor}"/>
      <SolidColorBrush x:Key="UpdateDialog.AccentBrush" Color="{StaticResource UpdateDialog.AccentColor}"/>
      <SolidColorBrush x:Key="UpdateDialog.SuccessBrush" Color="{StaticResource UpdateDialog.SuccessColor}"/>
      <SolidColorBrush x:Key="UpdateDialog.ErrorBrush" Color="{StaticResource UpdateDialog.ErrorColor}"/>
      <SolidColorBrush x:Key="UpdateDialog.ControlFillBrush" Color="{StaticResource UpdateDialog.ControlFillColor}"/>
      <SolidColorBrush x:Key="UpdateDialog.ControlFillHoverBrush" Color="{StaticResource UpdateDialog.ControlFillHoverColor}"/>
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <!-- アイコン Geometry (Light/Dark 共通: 形状はテーマ非依存。色は Path.Fill 側で DynamicResource 解決) -->
  <StreamGeometry x:Key="UpdateDialog.InfoGeometry">M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z</StreamGeometry>

</ResourceDictionary>
