<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:upd="using:VelopackUpdateDialog"
        x:Class="DemoApp.MainWindow"
        Width="640" Height="420"
        Title="VelopackUpdateDialog.Avalonia Demo"
        Background="Transparent"
        ExtendClientAreaTitleBarHeightHint="32"
        ExtendClientAreaToDecorationsHint="True"
        TransparencyLevelHint="AcrylicBlur,Blur,None">

  <Panel>
    <ExperimentalAcrylicBorder IsHitTestVisible="False">
      <ExperimentalAcrylicBorder.Material>
        <ExperimentalAcrylicMaterial BackgroundSource="Digger"
                                     MaterialOpacity="0.85"
                                     TintColor="{DynamicResource Demo.AcrylicTint}"
                                     TintOpacity="0.9"/>
      </ExperimentalAcrylicBorder.Material>
    </ExperimentalAcrylicBorder>

    <Grid RowDefinitions="Auto,*" Margin="16,40,16,16">

    <StackPanel Grid.Row="0" Orientation="Vertical" Spacing="8">
      <TextBlock Text="VelopackUpdateDialog.Avalonia Demo" FontSize="20" FontWeight="Bold"/>
      <TextBlock Text="各ボタンで 5 状態のダイアログを出して確認できます。" Foreground="#666"/>

      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,12,0,0">

        <Button Grid.Row="0" Grid.Column="0"
                Margin="0,0,8,8"
                HorizontalAlignment="Stretch"
                Content="Show: Available (新版あり)"
                Click="OnShowAvailable"/>

        <Button Grid.Row="0" Grid.Column="1"
                Margin="0,0,0,8"
                HorizontalAlignment="Stretch"
                Content="Show: UpToDate (最新版)"
                Click="OnShowUpToDate"/>

        <Button Grid.Row="1" Grid.Column="0"
                Margin="0,0,8,8"
                HorizontalAlignment="Stretch"
                Content="Show: Failed (失敗)"
                Click="OnShowFailed"/>

        <Button Grid.Row="1" Grid.Column="1"
                Margin="0,0,0,8"
                HorizontalAlignment="Stretch"
                Content="Show: Checking (確認中)"
                Click="OnShowChecking"/>

        <Button Grid.Row="2" Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="0,0,0,8"
                HorizontalAlignment="Stretch"
                Content="Show: Downloading (ダウンロード中, 35%)"
                Click="OnShowDownloading"/>

        <Button Grid.Row="3" Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="0,0,0,8"
                HorizontalAlignment="Stretch"
                Content="Show: Resizable + System chrome (可変ウィンドウ)"
                Click="OnShowResizableSystem"/>

        <Button Grid.Row="4" Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="0,0,0,8"
                HorizontalAlignment="Stretch"
                Content="Show: 日本語ローカライズ"
                Click="OnShowJapanese"/>
      </Grid>

      <TextBlock x:Name="ResultLabel" Margin="0,16,0,0" Foreground="#0066FF"/>
    </StackPanel>

    <!-- View 直貼り デモ -->
    <Border Grid.Row="1" BorderThickness="1" BorderBrush="#DDD" CornerRadius="4" Margin="0,16,0,0">
      <Grid RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Margin="8,4" FontWeight="Bold" Text="UserControl 直貼りデモ (DataContext を切り替え)"/>
        <upd:UpdateDialogView Grid.Row="1" x:Name="InlineView"/>
      </Grid>
    </Border>
    </Grid>
  </Panel>
</Window>
